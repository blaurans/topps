# Identifiants Google — À COPIER SUR LE SERVEUR, JAMAIS DANS LE DÉPÔT.
#
# Google Cloud Console → APIs et Services → Identifiants → Créer →
# ID client OAuth → Application Web. Puis :
#
#   URI de redirection autorisés : https://topps.laurans.org/auth/callback
#   Origines JavaScript autorisées : https://topps.laurans.org
#
# Renseigner les deux valeurs ci-dessous, puis sur ociub :
#   cp .env.example /app/topps/.env && $EDITOR /app/topps/.env

TOPPS_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
TOPPS_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# L'adresse publique du site : c'est elle qui détermine l'URI de
# redirection. Pas de barre oblique finale.
TOPPS_BASE_URL=https://topps.laurans.org

# Liste blanche d'adresses Gmail autorisées, séparées par des virgules.
# Vide = tout compte Google peut créer une collection. À remplir dès que
# quelqu'un d'autre que le propriétaire doit accéder au site.
TOPPS_ALLOWED_EMAILS=